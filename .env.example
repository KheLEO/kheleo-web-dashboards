APP_ORIGIN=http://localhost:3001
APP_ENV=development

# Upstream NestJS server-to-server relay URL (must end in /api/v1)
NEST_API_URL=http://localhost:3000/api/v1

# Optional public API alias; NEST_API_URL takes precedence. Browser uses the Next.js relay.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Realtime Socket.IO origin (pure origin only: scheme + host + optional port; no /api/v1 or /socket.io)
NEXT_PUBLIC_SOCKET_ORIGIN=http://localhost:3000

# Redis session & rate-limiting store (required in production/staging; set memory for local tests)
SESSION_STORE=redis
REDIS_URL=redis://localhost:6379/1

# Server-only shared secrets matching kheleo-core-backend (never prefix with NEXT_PUBLIC_)
DRILL_HMAC_SECRET=
TELEMETRY_SERVICE_HMAC_SECRET=

# Feature capability flags
SAFE_EVENTS_VERIFIED=true
DRILL_PRACTICE_INGESTION=true
SIMULATOR_INGESTION=true
STAGING_DATA_ISOLATED=false

# Optional map tile server override
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
