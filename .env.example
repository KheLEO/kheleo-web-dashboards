APP_ORIGIN=http://localhost:3001
NEST_API_URL=http://localhost:3000/api/v1
# Optional public API alias; NEST_API_URL takes precedence. The browser still uses the relay.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
APP_ENV=development
# Redis is required except when SESSION_STORE=memory in local development/tests.
REDIS_URL=redis://localhost:6379/1
SESSION_STORE=redis
NEXT_PUBLIC_SOCKET_ORIGIN=http://localhost:3000
# Optional Socket.IO alias; NEXT_PUBLIC_SOCKET_ORIGIN takes precedence. HTTP(S)/WS(S) origins only.
# NEXT_PUBLIC_WS_URL=ws://localhost:3000
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional, currently unused Supabase client configuration. NestJS owns platform authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Must match NestJS secrets. Never prefix these with NEXT_PUBLIC_.
DRILL_HMAC_SECRET=
TELEMETRY_SERVICE_HMAC_SECRET=
# NEXT_PUBLIC_DRILL_HMAC_SECRET is intentionally unsupported: it would expose the trusted signer.
# Keep disabled until backend room isolation has been fixed and verified.
SAFE_EVENTS_VERIFIED=false
# Simulator ingestion requires APP_ENV=staging AND this explicit assertion.
SIMULATOR_INGESTION=false
STAGING_DATA_ISOLATED=false

# Provisional drill estimates may affect only an explicitly isolated staging dataset.
DRILL_PRACTICE_INGESTION=false
