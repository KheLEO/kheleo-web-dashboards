{
  "name": "kheleo-web-dashboards",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "pnpm assets:sync && next dev --port 3001",
    "build": "pnpm assets:sync && next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:sync": "tsx scripts/sync-contracts.ts",
    "contracts:check": "tsx scripts/sync-contracts.ts --check",
    "assets:sync": "tsx scripts/sync-assets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.8.0",
    "ioredis": "^5.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.65.0",
    "react-leaflet": "^5.0.0",
    "react-webcam": "^7.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@prisma/internals": "6.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "socket.io": "^4.8.4",
    "tailwindcss": "~3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
