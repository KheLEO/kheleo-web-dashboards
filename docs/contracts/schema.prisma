datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ─── ENUMS ────────────────────────────────────────────────────────────────

enum UserRole {
  ATHLETE
  SCOUT
  UMPIRE
  ORGANIZER
  FEDERATION_ADMIN
  SUPER_ADMIN
}

enum GovIdType {
  AADHAAR
  VOTER_ID
  PASSPORT
  DRIVING_LICENSE
  BIRTH_CERTIFICATE
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  FLAGGED_DUPLICATE
  REVOKED
}

enum SportType {
  CRICKET
  FOOTBALL
  BADMINTON
  ATHLETICS
  BASKETBALL
  KABADDI
}

enum TierClassification {
  RURAL
  TIER_3
  TIER_2
  TIER_1
  METRO
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum BracketType {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum MatchStatus {
  SCHEDULED
  WARMUP
  LIVE
  PAUSED_SAFETY
  COMPLETED
  ABANDONED
}

enum FreeAgentStatus {
  QUEUED
  MATCHING
  MATCHED
  CANCELLED
  EVALUATING
  EXPIRED
  WITHDRAWN
}

enum DrillVerificationStatus {
  VALID
  INVALID_SIGNATURE
  ANOMALOUS_METRICS
  REJECTED_OUT_OF_BOUNDS
}

enum AlertSeverity {
  NORMAL
  WARNING
  CRITICAL
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED_SANDBAGGING
}

// ─── MODELS ───────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid()) @db.Uuid
  phone             String?  @unique @db.VarChar(20)
  email             String?  @unique @db.VarChar(255)
  role              UserRole @default(ATHLETE)
  isActive          Boolean  @default(true) @map("is_active")
  isRecoveryBlocked Boolean  @default(false) @map("is_recovery_blocked")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  athleteProfile         AthleteProfile?
  identityRecord         IdentityVerification?
  scoutDossiers          ScoutDossier[]          @relation("ScoutAuthor")
  organizedTours         Tournament[]            @relation("OrganizerTournaments")
  officiatedMatches      Match[]                 @relation("UmpireMatches")
  createdTeams           Team[]                  @relation("TeamCaptain")
  idempotencyKeys        IdempotencyRecord[]
  refreshTokens          RefreshToken[]
  registrations          Registration[]
  freeAgentRegistrations FreeAgentRegistration[]
  teamMembers            TeamMember[]
  drillSubmissions       DrillSubmission[]
  healthAlerts           HealthAlert[]
  scoutAlerts            ScoutAlert[]
  wearableSessions       WearableSession[]
  reportedMatchResults   VerifiedMatchResult[]   @relation("ResultReporter")
  acknowledgedAlerts     HealthAlert[]           @relation("AlertAcknowledger")
  tournamentVitals       TournamentVital[]

  @@index([role, isActive])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  family    String   @db.VarChar(64)
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

model IdentityVerification {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  idHash            String             @unique @map("id_hash") @db.VarChar(64)
  idType            GovIdType          @map("id_type")
  saltVersion       Int                @default(1) @map("salt_version")
  status            VerificationStatus @default(VERIFIED)
  reLinkedCount     Int                @default(0) @map("re_linked_count")
  historicalUserIds String[]           @default([]) @map("historical_user_ids")
  verifiedAt        DateTime           @default(now()) @map("verified_at") @db.Timestamptz
  metadata          Json?              @db.JsonB

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([idHash])
  @@index([status])
  @@map("identity_verifications")
}

model AthleteProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  dateOfBirth        DateTime?          @map("date_of_birth") @db.Date
  gender             String?            @db.VarChar(16)
  primarySport       SportType?         @map("primary_sport")
  secondarySports    SportType[]        @default([]) @map("secondary_sports")
  district           String             @db.VarChar(100)
  state              String             @db.VarChar(100)
  tierClassification TierClassification @default(RURAL) @map("tier_classification")

  heightCm     Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  dominantSide String?  @map("dominant_side") @db.VarChar(16)

  /// PostGIS geometry column - managed via raw SQL migrations
  locationGeom Unsupported("geometry(Point, 4326)")? @map("location")
  locationLat  Float?                                @map("location_lat")
  locationLng  Float?                                @map("location_lng")

  currentGti                Decimal @default(30.00) @map("current_gti") @db.Decimal(5, 2)
  gti                       Float   @default(0.0) @map("gti")
  biomechanicalScore        Float   @default(0.0) @map("biomechanical_score")
  trainingConsistencyScore  Float   @default(0.0) @map("training_consistency_score")
  matchPerformanceScore     Float   @default(0.0) @map("match_performance_score")
  isRuralOrUnderrepresented Boolean @default(false) @map("is_rural_or_underrepresented")
  posturePoints             Int     @default(0) @map("posture_points")
  wearableScore             Decimal @default(50.00) @map("wearable_score") @db.Decimal(5, 2)
  matchPerfScore            Decimal @default(50.00) @map("match_perf_score") @db.Decimal(5, 2)
  isScoutSearchable         Boolean @default(true) @map("is_scout_searchable")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sportRecords     SportPassportRecord[]
  gtiHistories     GtiHistory[]
  scoutDossiers    ScoutDossier[]        @relation("AthleteDossiers")
  teamMemberships  TeamMember[]
  freeAgentEntries FreeAgentPool[]

  @@index([currentGti(sort: Desc)])
  @@index([primarySport, currentGti(sort: Desc)])
  @@index([district, state])
  @@index([tierClassification, currentGti(sort: Desc)])
  @@index([locationGeom], type: Gist, map: "idx_athlete_profiles_location_gist")
  @@map("athlete_profiles")
}

model SportPassportRecord {
  id              String    @id @default(uuid()) @db.Uuid
  athleteId       String    @map("athlete_id") @db.Uuid
  sport           SportType
  primaryRole     String    @map("primary_role") @db.VarChar(50)
  secondaryRoles  String[]  @default([]) @map("secondary_roles")
  totalMatches    Int       @default(0) @map("total_matches")
  winCount        Int       @default(0) @map("win_count")
  winStreak       Int       @default(0) @map("win_streak")
  verifiedMetrics Json      @default("{}") @map("verified_metrics") @db.JsonB
  earnedBadges    Json      @default("[]") @map("earned_badges") @db.JsonB
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sport])
  @@index([sport, primaryRole])
  @@map("sport_passport_records")
}

model Tournament {
  id          String           @id @default(uuid()) @db.Uuid
  organizerId String           @map("organizer_id") @db.Uuid
  name        String           @default("") @db.VarChar(255)
  title       String           @db.VarChar(255)
  sport       SportType
  status      TournamentStatus @default(DRAFT)
  minGti      Decimal          @default(0.00) @map("min_gti") @db.Decimal(5, 2)
  maxGti      Decimal          @default(100.00) @map("max_gti") @db.Decimal(5, 2)
  maxTeams    Int              @map("max_teams")
  teamSize    Int              @map("team_size")
  prizePool   Decimal          @default(0.00) @map("prize_pool") @db.Decimal(12, 2)
  currency    String           @default("INR") @db.VarChar(3)

  venueName String @map("venue_name") @db.VarChar(255)
  venueLat  Float  @map("venue_lat")
  venueLng  Float  @map("venue_lng")

  /// PostGIS geometry column - managed via raw SQL trigger on insert/update
  venueGeom Unsupported("geometry(Point, 4326)")? @map("location")

  registrationDeadline DateTime @map("registration_deadline") @db.Timestamptz
  startDate            DateTime @map("start_date") @db.Timestamptz
  endDate              DateTime @map("end_date") @db.Timestamptz
  rulesConfig          Json     @default("{}") @map("rules_config") @db.JsonB
  isFeatured           Boolean  @default(false) @map("is_featured")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organizer              User                    @relation("OrganizerTournaments", fields: [organizerId], references: [id])
  brackets               Bracket[]
  teams                  Team[]
  freeAgentQueue         FreeAgentPool[]
  freeAgentRegistrations FreeAgentRegistration[]
  healthAlerts           HealthAlert[]
  vitals                 TournamentVital[]

  @@index([sport, status])
  @@index([minGti, maxGti])
  @@index([registrationDeadline])
  @@index([venueGeom], type: Gist, map: "idx_tournaments_location_gist")
  @@map("tournaments")
}

model Bracket {
  id           String      @id @default(uuid()) @db.Uuid
  tournamentId String      @map("tournament_id") @db.Uuid
  name         String      @db.VarChar(100)
  tierName     String      @default("OPEN") @map("tier_name") @db.VarChar(100)
  minGti       Decimal     @default(0.00) @map("min_gti") @db.Decimal(5, 2)
  maxGti       Decimal     @default(100.00) @map("max_gti") @db.Decimal(5, 2)
  entryFee     Decimal     @default(0.00) @map("entry_fee") @db.Decimal(10, 2)
  maxTeams     Int         @default(16) @map("max_teams")
  bracketType  BracketType @default(SINGLE_ELIMINATION) @map("bracket_type")
  roundOrder   Int         @default(1) @map("round_order")
  config       Json        @default("{}") @db.JsonB

  tournament             Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches                Match[]
  registrations          Registration[]
  teams                  Team[]
  freeAgentRegistrations FreeAgentRegistration[]
  healthAlerts           HealthAlert[]
  verifiedResults        VerifiedMatchResult[]

  @@index([tournamentId, roundOrder])
  @@map("brackets")
}

model Registration {
  id           String             @id @default(uuid()) @db.Uuid
  bracketId    String             @map("bracket_id") @db.Uuid
  userId       String?            @map("user_id") @db.Uuid
  teamId       String?            @map("team_id") @db.Uuid
  status       RegistrationStatus @default(CONFIRMED)
  feePaid      Decimal            @default(0.00) @map("fee_paid") @db.Decimal(10, 2)
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz
  metadata     Json?              @db.JsonB

  bracket Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([bracketId, userId])
  @@index([bracketId, status])
  @@index([userId])
  @@map("registrations")
}

model Team {
  id                String   @id @default(uuid()) @db.Uuid
  tournamentId      String   @map("tournament_id") @db.Uuid
  bracketId         String?  @map("bracket_id") @db.Uuid
  name              String   @db.VarChar(100)
  captainId         String?  @map("captain_id") @db.Uuid
  isFreeAgentTeam   Boolean  @default(false) @map("is_free_agent_team")
  isFreeAgentFormed Boolean  @default(false) @map("is_free_agent_formed")
  compositeGti      Decimal  @default(0.00) @map("composite_gti") @db.Decimal(5, 2)
  averageGti        Float    @default(0.00) @map("average_gti")
  registrationDate  DateTime @default(now()) @map("registration_date") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  tournament             Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracket                Bracket?                @relation(fields: [bracketId], references: [id], onDelete: SetNull)
  captain                User?                   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  members                TeamMember[]
  matchesAsTeamA         Match[]                 @relation("MatchTeamA")
  matchesAsTeamB         Match[]                 @relation("MatchTeamB")
  wonMatches             Match[]                 @relation("MatchWinner")
  formedFromAgents       FreeAgentPool[]
  freeAgentRegistrations FreeAgentRegistration[]
  registrations          Registration[]

  @@index([tournamentId, isFreeAgentTeam])
  @@index([bracketId])
  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  athleteId    String?  @map("athlete_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  role         String?  @db.VarChar(50)
  assignedRole String   @default("MEMBER") @map("assigned_role") @db.VarChar(50)
  isCaptain    Boolean  @default(false) @map("is_captain")
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete AthleteProfile? @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([userId])
  @@map("team_members")
}

model FreeAgentRegistration {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  tournamentId  String          @map("tournament_id") @db.Uuid
  bracketId     String          @map("bracket_id") @db.Uuid
  sport         String          @db.VarChar(50)
  primaryRole   String          @map("primary_role") @db.VarChar(50)
  secondaryRole String?         @map("secondary_role") @db.VarChar(50)
  status        FreeAgentStatus @default(QUEUED)
  matchedTeamId String?         @map("matched_team_id") @db.Uuid
  joinedAt      DateTime        @default(now()) @map("joined_at") @db.Timestamptz

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracket     Bracket    @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  matchedTeam Team?      @relation(fields: [matchedTeamId], references: [id], onDelete: SetNull)

  @@index([bracketId, status, primaryRole])
  @@index([tournamentId, status])
  @@index([userId, status])
  @@map("free_agent_registrations")
}

model FreeAgentPool {
  id             String          @id @default(uuid()) @db.Uuid
  tournamentId   String          @map("tournament_id") @db.Uuid
  athleteId      String          @map("athlete_id") @db.Uuid
  sport          SportType
  preferredRole  String          @map("preferred_role") @db.VarChar(50)
  secondaryRoles String[]        @default([]) @map("secondary_roles")
  athleteGti     Decimal         @map("athlete_gti") @db.Decimal(5, 2)
  status         FreeAgentStatus @default(QUEUED)
  queuedAt       DateTime        @default(now()) @map("queued_at") @db.Timestamptz
  matchedAt      DateTime?       @map("matched_at") @db.Timestamptz
  matchedTeamId  String?         @map("matched_team_id") @db.Uuid

  tournament  Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  matchedTeam Team?          @relation(fields: [matchedTeamId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, athleteId])
  @@index([tournamentId, status, preferredRole])
  @@map("free_agent_pools")
}

model Match {
  id             String      @id @default(uuid()) @db.Uuid
  bracketId      String      @map("bracket_id") @db.Uuid
  round          Int         @default(1)
  matchNumber    Int         @map("match_number")
  teamAId        String      @map("team_a_id") @db.Uuid
  teamBId        String      @map("team_b_id") @db.Uuid
  umpireId       String?     @map("umpire_id") @db.Uuid
  scheduledStart DateTime    @map("scheduled_start") @db.Timestamptz
  status         MatchStatus @default(SCHEDULED)
  winnerTeamId   String?     @map("winner_team_id") @db.Uuid
  scoreSummary   Json        @default("{}") @map("score_summary") @db.JsonB
  pauseReason    String?     @map("pause_reason") @db.VarChar(255)
  pausedAt       DateTime?   @map("paused_at") @db.Timestamptz

  bracket        Bracket              @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  teamA          Team                 @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB          Team                 @relation("MatchTeamB", fields: [teamBId], references: [id])
  umpire         User?                @relation("UmpireMatches", fields: [umpireId], references: [id])
  winnerTeam     Team?                @relation("MatchWinner", fields: [winnerTeamId], references: [id])
  healthAlerts   HealthAlert[]
  verifiedResult VerifiedMatchResult?

  @@index([bracketId, status])
  @@index([teamAId, teamBId])
  @@map("matches")
}

model DrillSubmission {
  id                 String                @id @default(uuid()) @db.Uuid
  athleteId          String                @map("athlete_id") @db.Uuid
  sport              String                @db.VarChar(50)
  drillType          String                @map("drill_type") @db.VarChar(64)
  formScore          Float                 @map("form_score")
  framesAnalyzed     Int                   @map("frames_analyzed")
  flawFlags          Json                  @map("flaw_flags") @db.JsonB
  jointAnglesSummary Json                  @map("joint_angles_summary") @db.JsonB
  signatureHash      String                @unique @map("signature_hash") @db.VarChar(64)
  signatureVersion   DrillSignatureVersion @default(LEGACY) @map("signature_version")
  clientPoseDigest   String?               @map("client_pose_digest") @db.VarChar(64)
  metadataVerified   Boolean               @default(false) @map("metadata_verified")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz

  athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, clientPoseDigest])
  @@index([athleteId, createdAt(sort: Desc)])
  @@index([sport, drillType, formScore(sort: Desc)])
  @@map("drill_submissions")
}

model HealthAlert {
  id                     String          @id @default(uuid()) @db.Uuid
  athleteId              String          @map("athlete_id") @db.Uuid
  tournamentId           String?         @map("tournament_id") @db.Uuid
  bracketId              String?         @map("bracket_id") @db.Uuid
  severity               AlertSeverity   @default(NORMAL)
  heartRate              Float           @map("heart_rate")
  spo2                   Float           @map("spo2")
  skinTemperature        Float           @map("skin_temperature")
  triggerReason          String          @map("trigger_reason")
  matchPaused            Boolean         @default(false) @map("match_paused")
  matchId                String?         @map("match_id") @db.Uuid
  medicalCheckNote       String?         @map("medical_check_note") @db.VarChar(1000)
  medicalCheckDispatched Boolean         @default(false) @map("medical_check_dispatched")
  acknowledgedAt         DateTime?       @map("acknowledged_at") @db.Timestamptz
  acknowledgedById       String?         @map("acknowledged_by_id") @db.Uuid
  baselineFields         String[]        @default([]) @map("baseline_fields")
  source                 TelemetrySource @default(DEVICE_HMAC)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz

  athlete        User        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  match          Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)
  acknowledgedBy User?       @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  tournament     Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  bracket        Bracket?    @relation(fields: [bracketId], references: [id], onDelete: SetNull)

  @@index([athleteId, createdAt(sort: Desc)])
  @@index([severity, matchPaused])
  @@map("health_alerts")
}

model ScoutAlert {
  id             String   @id @default(uuid()) @db.Uuid
  athleteId      String   @map("athlete_id") @db.Uuid
  gtiScore       Float    @map("gti_score")
  district       String   @db.VarChar(100)
  sport          String   @db.VarChar(50)
  isAcknowledged Boolean  @default(false) @map("is_acknowledged")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, isAcknowledged])
  @@index([sport, district])
  @@map("scout_alerts")
}

model GtiHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  athleteId          String   @map("athlete_id") @db.Uuid
  biomechanicalScore Decimal  @map("biomechanical_score") @db.Decimal(5, 2)
  wearableScore      Decimal  @map("wearable_score") @db.Decimal(5, 2)
  matchScore         Decimal  @map("match_score") @db.Decimal(5, 2)
  compositeGti       Decimal  @map("composite_gti") @db.Decimal(5, 2)
  calculationFactors Json     @map("calculation_factors") @db.JsonB
  calculatedAt       DateTime @default(now()) @map("calculated_at") @db.Timestamptz

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, calculatedAt(sort: Desc)])
  @@map("gti_histories")
}

model ScoutDossier {
  id               String   @id @default(uuid()) @db.Uuid
  athleteId        String   @map("athlete_id") @db.Uuid
  scoutId          String   @map("scout_id") @db.Uuid
  scoutNotes       String   @map("scout_notes") @db.Text
  organizationName String?  @map("organization_name") @db.VarChar(200)
  outreachHistory  Json     @default("[]") @map("outreach_history") @db.JsonB
  federationTag    String?  @map("federation_tag") @db.VarChar(100)
  isShortlisted    Boolean  @default(false) @map("is_shortlisted")
  pipelineStatus   String   @default("DISCOVERED") @map("pipeline_status") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  athlete AthleteProfile @relation("AthleteDossiers", fields: [athleteId], references: [id], onDelete: Cascade)
  scout   User           @relation("ScoutAuthor", fields: [scoutId], references: [id], onDelete: Cascade)

  @@unique([athleteId, scoutId])
  @@index([scoutId, pipelineStatus])
  @@map("scout_dossiers")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique @db.VarChar(128)
  userId       String?  @map("user_id") @db.Uuid
  route        String   @db.VarChar(255)
  responseCode Int      @map("response_code")
  responseBody Json     @map("response_body") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key, expiresAt])
  @@map("idempotency_records")
}

enum AuditCategory {
  GOV_ID_RESET
  DRILL_HMAC_TAMPER
  SANDBAGGING_BLOCKED
  SAFETY_MATCH_PAUSE
  ROLE_GOVERNANCE
  TOURNAMENT_MODERATION
  SYSTEM_EVENT
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model SecurityAuditLog {
  category    AuditCategory @default(SYSTEM_EVENT)
  severity    AuditSeverity @default(INFO)
  actorUserId String?       @map("actor_user_id") @db.Uuid
  targetId    String?       @map("target_id") @db.VarChar(255)
  summary     String        @default("") @db.VarChar(500)
  ipHash      String?       @map("ip_hash") @db.VarChar(64)
  id          String        @id @default(uuid()) @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  action      String        @db.VarChar(100)
  resource    String?       @db.VarChar(100)
  resourceId  String?       @map("resource_id") @db.VarChar(255)
  ipAddress   String?       @map("ip_address") @db.VarChar(45)
  userAgent   String?       @map("user_agent") @db.Text
  metadata    Json?         @db.JsonB
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([category, severity, createdAt(sort: Desc), id(sort: Desc)])
  @@map("security_audit_logs")
}

enum DrillSignatureVersion {
  LEGACY
  FULL
  FULL_V2
}

enum TelemetrySource {
  DEVICE_HMAC
  ATHLETE_JWT
  BLE
  SIMULATOR
}

model WearableSession {
  readingsCount        Int             @default(0) @map("readings_count")
  heartRateSum         Float           @default(0) @map("heart_rate_sum")
  spo2Sum              Float           @default(0) @map("spo2_sum")
  simulatorReadings    Int             @default(0) @map("simulator_readings")
  baselineSpo2Readings Int             @default(0) @map("baseline_spo2_readings")
  id                   String          @id @default(uuid()) @db.Uuid
  athleteId            String          @map("athlete_id") @db.Uuid
  sessionDate          DateTime        @map("session_date") @db.Date
  source               TelemetrySource
  baselineFields       String[]        @default([]) @map("baseline_fields")
  observedAt           DateTime        @default(now()) @map("observed_at") @db.Timestamptz
  athlete              User            @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sessionDate])
  @@map("wearable_sessions")
}

model VerifiedMatchResult {
  id                    String   @id @default(uuid()) @db.Uuid
  bracketId             String   @map("bracket_id") @db.Uuid
  matchId               String?  @unique @map("match_id") @db.Uuid
  reportedById          String   @map("reported_by_id") @db.Uuid
  requestKey            String   @unique @map("request_key") @db.VarChar(64)
  fingerprint           String   @db.VarChar(64)
  matchName             String   @default("") @map("match_name") @db.VarChar(150)
  scoreSummary          Json     @default("{}") @map("score_summary") @db.JsonB
  participantAthleteIds String[] @map("participant_athlete_ids") @db.Uuid
  winnerAthleteIds      String[] @map("winner_athlete_ids") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  bracket               Bracket  @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  match                 Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  reportedBy            User     @relation("ResultReporter", fields: [reportedById], references: [id])

  @@index([bracketId, createdAt(sort: Desc)])
  @@index([participantAthleteIds], type: Gin)
  @@map("verified_match_results")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String    @db.VarChar(32)
  payload     Json      @db.JsonB
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz
  lockedBy    String?   @map("locked_by") @db.Uuid
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  lastError   String?   @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([deliveredAt, availableAt])
  @@map("outbox_events")
}

model TournamentVital {
  id              String          @id @default(uuid()) @db.Uuid
  tournamentId    String          @map("tournament_id") @db.Uuid
  athleteId       String          @map("athlete_id") @db.Uuid
  bracketId       String?         @map("bracket_id") @db.Uuid
  matchId         String?         @map("match_id") @db.Uuid
  heartRate       Float           @map("heart_rate")
  spo2            Float
  skinTemperature Float           @map("skin_temperature")
  severity        AlertSeverity
  source          TelemetrySource
  baselineFields  String[]        @default([]) @map("baseline_fields")
  observedAt      DateTime        @map("observed_at") @db.Timestamptz
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz
  tournament      Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  athlete         User            @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, athleteId])
  @@index([tournamentId, severity])
  @@map("tournament_vitals")
}
